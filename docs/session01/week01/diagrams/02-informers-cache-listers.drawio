          vertex="1" parent="1">
          <mxGeometry x="220" y="210" width="220" height="25" as="geometry" />
        </mxCell>

        <!-- EDGES -->
        <!-- API Server → Reflector (List + Watch) -->
        <mxCell id="30" value="List + Watch"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d79b00;fontSize=10;fontStyle=1;"
          edge="1" parent="1" source="3" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reflector → DeltaFIFO -->
        <mxCell id="31" value="deltas"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#9673a6;fontSize=10;"
          edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DeltaFIFO → Indexer -->
        <mxCell id="32" value="pop + process"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d6b656;fontSize=10;"
          edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Indexer → SharedIndexInformer -->
        <mxCell id="33" value=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;"
          edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SharedIndexInformer → Event Handlers -->
        <mxCell id="34" value="notificaciones"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;fontSize=10;"
          edge="1" parent="1" source="8" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Indexer → Lister (read path) -->
        <mxCell id="35" value="consulta sin red"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#6c8ebf;dashed=1;fontSize=10;"
          edge="1" parent="1" source="7" target="13">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="140" />
              <mxPoint x="680" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Lister → Controller -->
        <mxCell id="36" value="pod, rs, deploy..."
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;fontSize=10;"
          edge="1" parent="1" source="13" target="14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Handler enqueues key → Controller -->
        <mxCell id="37" value="encola namespace/name"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;entryX=1;entryY=0.5;strokeColor=#82b366;fontSize=10;"
          edge="1" parent="1" source="9" target="14">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="420" />
              <mxPoint x="930" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Relist loop back -->
        <mxCell id="38" value="relist si falla el watch"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;entryX=0;entryY=1;strokeColor=#9673a6;dashed=1;fontSize=9;"
