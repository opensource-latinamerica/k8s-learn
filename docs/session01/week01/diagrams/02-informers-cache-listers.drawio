          <mxGeometry x="20" y="30" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="11" value="OnUpdate(old, new)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;"
          vertex="1" parent="9">
          <mxGeometry x="20" y="65" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="12" value="OnDelete(obj)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;"
          vertex="1" parent="9">
          <mxGeometry x="20" y="100" width="120" height="30" as="geometry" />
        </mxCell>

        <!-- Lister -->
        <mxCell id="13" value="Lister&#xa;(lee desde caché)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;arcSize=10;"
