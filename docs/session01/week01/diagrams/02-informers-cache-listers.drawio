<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Informers y Caché">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="2" value="Informers, Caché y Listers en Kubernetes"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- Container: API Server -->
        <mxCell id="3" value="API Server"
          style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="4" value="etcd&#xa;(almacén de estado)"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;"
          vertex="1" parent="3">
          <mxGeometry x="20" y="40" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Reflector -->
        <mxCell id="5" value="Reflector&#xa;ListAndWatch()"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="250" y="110" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- DeltaFIFO -->
        <mxCell id="6" value="DeltaFIFO&#xa;(cola de deltas)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="470" y="110" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Indexer / Store -->
        <mxCell id="7" value="Indexer / Store&#xa;(caché local thread-safe)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="690" y="110" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- SharedIndexInformer -->
        <mxCell id="8" value="SharedIndexInformer&#xa;(despacha eventos)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="690" y="260" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- Event Handlers container -->
        <mxCell id="9" value="Event Handlers"
          style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="930" y="230" width="160" height="140" as="geometry" />
        </mxCell>
        <mxCell id="10" value="OnAdd(obj)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;"
