          <mxGeometry x="470" y="290" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Controller -->
        <mxCell id="14" value="Controller&#xa;(reconcileKey)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="470" y="420" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Annotation: List initial -->
        <mxCell id="15" value="1. List inicial (todos los objetos)"
          style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=left;verticalAlign=middle;fontSize=10;rounded=1;"
          vertex="1" parent="1">
          <mxGeometry x="140" y="90" width="200" height="25" as="geometry" />
        </mxCell>

        <!-- Annotation: Watch stream -->
        <mxCell id="16" value="2. Watch continuo (eventos delta)"
