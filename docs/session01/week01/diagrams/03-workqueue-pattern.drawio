<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Workqueue Pattern">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="2" value="Workqueue en Kubernetes: desacoplamiento observación-procesamiento"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="820" height="40" as="geometry" />
        </mxCell>

        <!-- ===== LEFT SIDE: Observation / Informer ===== -->
        <mxCell id="3" value="Capa de Observación (Informer)"
          style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="220" height="300" as="geometry" />
        </mxCell>

        <mxCell id="4" value="OnAdd(obj)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
          vertex="1" parent="3">
          <mxGeometry x="20" y="45" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="5" value="OnUpdate(old, new)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
          vertex="1" parent="3">
          <mxGeometry x="20" y="110" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="6" value="OnDelete(obj)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
          vertex="1" parent="3">
          <mxGeometry x="20" y="175" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="7" value="extrae namespace/name"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=2;"
          vertex="1" parent="3">
          <mxGeometry x="20" y="230" width="180" height="25" as="geometry" />
        </mxCell>

        <!-- ===== CENTER: Workqueue ===== -->
        <mxCell id="8" value="Workqueue&#xa;(TypedRateLimitingInterface)"
          style="swimlane;startSize=35;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="220" height="300" as="geometry" />
        </mxCell>

        <!-- Internal structures within WQ -->
        <mxCell id="9" value="queue [ ] (FIFO)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;"
          vertex="1" parent="8">
          <mxGeometry x="20" y="45" width="180" height="35" as="geometry" />
        </mxCell>

        <mxCell id="10" value="dirty (set pendiente)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;"
          vertex="1" parent="8">
          <mxGeometry x="20" y="100" width="180" height="35" as="geometry" />
        </mxCell>

        <mxCell id="11" value="processing (en vuelo)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;"
          vertex="1" parent="8">
          <mxGeometry x="20" y="155" width="180" height="35" as="geometry" />
        </mxCell>

        <mxCell id="12" value="RateLimiter&#xa;(backoff exponencial)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
          vertex="1" parent="8">
          <mxGeometry x="20" y="210" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- ===== RIGHT SIDE: Workers ===== -->
        <mxCell id="13" value="Capa de Procesamiento (Workers)"
          style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="280" height="300" as="geometry" />
        </mxCell>

        <mxCell id="14" value="Worker 1&#xa;queue.Get() → key"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;"
          vertex="1" parent="13">
          <mxGeometry x="15" y="45" width="250" height="40" as="geometry" />
        </mxCell>

        <mxCell id="15" value="Worker 2&#xa;queue.Get() → key"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;"
          vertex="1" parent="13">
          <mxGeometry x="15" y="100" width="250" height="40" as="geometry" />
        </mxCell>

        <mxCell id="16" value="reconcile(key):&#xa;  leer estado actual (Lister)&#xa;  comparar con deseado (.spec)&#xa;  tomar acción"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;"
          vertex="1" parent="13">
          <mxGeometry x="15" y="155" width="250" height="65" as="geometry" />
        </mxCell>

        <mxCell id="17" value="queue.Done(key)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;"
          vertex="1" parent="13">
          <mxGeometry x="15" y="235" width="250" height="35" as="geometry" />
        </mxCell>

        <!-- ===== BOTTOM: Error handling ===== -->
        <mxCell id="18" value="Error en reconcile"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="340" y="440" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="19" value="queue.AddRateLimited(key)&#xa;(reencola con backoff)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="340" y="570" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="20" value="Éxito"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="630" y="455" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- Dedup note -->
        <mxCell id="21" value="Deduplicación: si 'ns/name' ya está en queue o dirty,&#xa;Add() no crea duplicado → el worker siempre ve el estado más reciente"
          style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;fontSize=10;rounded=1;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- EDGES -->
        <!-- OnAdd/OnUpdate/OnDelete → WQ.Add() -->
        <mxCell id="40" value="Add(ns/name)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;strokeColor=#9673a6;fontSize=10;fontStyle=1;"
          edge="1" parent="1" source="3" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WQ → Workers (Get) -->
        <mxCell id="41" value="Get()"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;strokeColor=#d6b656;fontSize=10;fontStyle=1;"
          edge="1" parent="1" source="8" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Worker → Error diamond -->
        <mxCell id="42" value="error?"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#b85450;fontSize=10;"
          edge="1" parent="1" source="13" target="18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Error → requeue -->
        <mxCell id="43" value="Sí"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#b85450;fontColor=#b85450;fontSize=11;fontStyle=1;"
          edge="1" parent="1" source="18" target="19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Requeue loops back to WQ -->
        <mxCell id="44" value="vuelve al workqueue&#xa;con delay"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0;entryY=1;strokeColor=#b85450;dashed=1;fontSize=10;"
          edge="1" parent="1" source="19" target="8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="595" />
              <mxPoint x="300" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Error → success (No) -->
        <mxCell id="45" value="No"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;fontColor=#82b366;fontSize=11;fontStyle=1;"
          edge="1" parent="1" source="18" target="20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Done called after success too -->
        <mxCell id="46" value="queue.Done(key)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=1;entryY=1;strokeColor=#82b366;fontSize=10;"
          edge="1" parent="1" source="20" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
