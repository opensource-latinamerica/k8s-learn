<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Namespace Controller">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="2" value="Controlador de Namespace en Kubernetes"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="820" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== TOP: Lifecycle States ===================== -->
        <mxCell id="3" value="Ciclo de vida del Namespace"
          style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="840" height="170" as="geometry" />
        </mxCell>

        <!-- Start marker -->
        <mxCell id="4" value=""
          style="ellipse;aspect=fixed;html=1;fillColor=#000000;strokeColor=#000000;"
          vertex="1" parent="3">
          <mxGeometry x="30" y="70" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Active state -->
        <mxCell id="5" value="Active&#xa;(status.phase = Active)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;arcSize=15;"
          vertex="1" parent="3">
          <mxGeometry x="130" y="55" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- Terminating state -->
        <mxCell id="6" value="Terminating&#xa;(status.phase = Terminating)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;arcSize=15;"
          vertex="1" parent="3">
          <mxGeometry x="430" y="55" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- End marker -->
        <mxCell id="7" value=""
          style="ellipse;aspect=fixed;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=3;fillColor=#ffffff;"
          vertex="1" parent="3">
          <mxGeometry x="760" y="70" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7b" value=""
          style="ellipse;aspect=fixed;html=1;fillColor=#000000;strokeColor=#000000;"
          vertex="1" parent="3">
          <mxGeometry x="765" y="75" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Edges within lifecycle -->
        <mxCell id="8" value=""
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#000000;"
          edge="1" parent="3" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="9" value="kubectl delete namespace&#xa;(fija deletionTimestamp)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;fontSize=10;fontStyle=1;"
          edge="1" parent="3" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Self-loop on Terminating -->
        <mxCell id="10" value="borrado de recursos en curso&#xa;(ResourcesRemainingError)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;strokeColor=#b85450;fontSize=10;dashed=1;"
          edge="1" parent="3" source="6" target="6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="25" />
              <mxPoint x="540" y="25" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="11" value="finalizers vacíos&#xa;(etcd elimina objeto)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;fontSize=10;fontStyle=1;"
          edge="1" parent="3" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Admission plugin note -->
        <mxCell id="12" value="⚠ NamespaceLifecycle admission plugin: rechaza creación de recursos en Terminating"
          style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;fontSize=10;rounded=1;"
          vertex="1" parent="3">
          <mxGeometry x="100" y="125" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== BOTTOM: Controller Architecture ===================== -->
        <mxCell id="20" value="Arquitectura interna del NamespaceController"
          style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="840" height="300" as="geometry" />
        </mxCell>

        <!-- NamespaceInformer -->
        <mxCell id="21" value="NamespaceInformer&#xa;(SharedIndexInformer)"
