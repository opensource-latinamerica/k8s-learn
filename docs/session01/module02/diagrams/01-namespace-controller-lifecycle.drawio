          vertex="1" parent="20">
          <mxGeometry x="30" y="50" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- WorkQueue -->
        <mxCell id="22" value="workqueue&#xa;(TypedRateLimitingInterface)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;arcSize=10;"
          vertex="1" parent="20">
          <mxGeometry x="280" y="50" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Worker -->
        <mxCell id="23" value="worker&#xa;syncNamespaceFromKey()"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;arcSize=10;"
          vertex="1" parent="20">
          <mxGeometry x="560" y="50" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- NamespacedResourcesDeleter subcomponent -->
        <mxCell id="24" value="NamespacedResourcesDeleter"
          style="swimlane;startSize=28;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;"
          vertex="1" parent="20">
          <mxGeometry x="410" y="160" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="25" value="1. Marca namespace como Terminating"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;"
          vertex="1" parent="24">
          <mxGeometry x="10" y="30" width="380" height="20" as="geometry" />
        </mxCell>

        <mxCell id="26" value="2. Llama a API server para borrar todos los recursos (pods, svc, cm...)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;"
          vertex="1" parent="24">
          <mxGeometry x="10" y="55" width="380" height="20" as="geometry" />
        </mxCell>

        <mxCell id="27" value="3. Elimina finalizer kubernetes cuando ya no quedan recursos"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;"
          vertex="1" parent="24">
          <mxGeometry x="10" y="80" width="380" height="25" as="geometry" />
        </mxCell>

        <!-- syncNamespaceFromKey decision -->
        <mxCell id="28" value="¿deletionTimestamp&#xa;!= nil?"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;"
          vertex="1" parent="20">
          <mxGeometry x="250" y="165" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- No - do nothing note -->
        <mxCell id="29" value="namespace activo&#xa;→ noop"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=10;"
          vertex="1" parent="20">
          <mxGeometry x="60" y="185" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- Edges within controller -->
        <mxCell id="40" value="Add(ns/key)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#9673a6;fontSize=10;"
