          edge="1" parent="20" source="23" target="28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="43" value="Sí → terminar"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;fontSize=10;"
          edge="1" parent="20" source="28" target="24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="44" value="No"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#82b366;fontSize=10;"
