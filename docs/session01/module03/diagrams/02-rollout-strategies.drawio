        <!-- maxSurge / maxUnavailable explanation -->
        <mxCell id="37" value="Parámetros clave:&#xa;• maxUnavailable: 25% → máx Pods no disponibles (redondea ↓)&#xa;• maxSurge: 25% → máx Pods extra sobre replicas (redondea ↑)&#xa;• Siempre hay Pods disponibles → zero downtime"
          style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;fontSize=10;rounded=1;"
          vertex="1" parent="19">
          <mxGeometry x="10" y="385" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- Use cases -->
        <mxCell id="38" value="Cuándo usar RollingUpdate:&#xa;• Aplicaciones stateless&#xa;• Se tolera convivencia de versiones&#xa;• Zero downtime requerido"
